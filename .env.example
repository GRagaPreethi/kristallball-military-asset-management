# Shared workspace example. Never put real values in this file.

# Required by @workspace/db and @workspace/api-server.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Required by the API server. Use a long, random value in deployment.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Set per process. The included Replit artifacts use 8080 for the API
# and 19373 for the Kristallball frontend.
PORT=8080

# Recommended runtime mode.
NODE_ENV=development

# Optional API logging level. Defaults to info.
LOG_LEVEL=info

# Required by Vite services. Kristallball uses /; mockup sandbox uses /__mockup.
BASE_PATH=/

# Optional: supplied automatically by Replit during development.
REPL_ID=